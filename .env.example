# Web search (https://tavily.com) - required for live research
TAVILY_API_KEY=your-tavily-key

# LLM - any OpenAI-compatible chat completions API with JSON mode
LLM_API_KEY=your-llm-key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini

# Supabase persistence (server-side only; never prefix with NEXT_PUBLIC_)
# If unset, guides are stored in .data/guides.json (local development only; not durable on Vercel)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional tuning
# GENERATE_RATE_LIMIT=5          # generations per IP per 10 minutes (per server instance)
# SEARCH_TIMEOUT_MS=25000
# LLM_TIMEOUT_MS=90000
